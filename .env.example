# Copie ce fichier en .env.local et remplis avec tes valeurs

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-clé-anon-publique

# Ton domaine final (utilisé pour le sitemap)
NEXT_PUBLIC_SITE_URL=https://siramag.netlify.app

# Optionnel — active le bouton "Envoyer" des campagnes newsletter (/admin/newsletter)
# Gratuit : resend.com -> crée un compte -> API Keys -> Create API Key
# 100 emails/jour, 3000/mois gratuits, sans carte bancaire.
# NE PAS mettre NEXT_PUBLIC_ devant ce nom (clé secrète, usage serveur uniquement).
RESEND_API_KEY=

# Optionnel — adresse d'expédition. Sans domaine vérifié sur Resend, utilise
# la valeur par défaut ci-dessous (fonctionne pour tester, mais mieux vaut
# vérifier ton propre domaine sur resend.com/domains pour la production).
RESEND_FROM_EMAIL=SIRA MAG <onboarding@resend.dev>
